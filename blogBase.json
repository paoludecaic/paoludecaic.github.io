4e00\u4e2a\u9605\u89c8\u91cf\u7edf\u8ba1\u63d2\u4ef6\uff0c\u57fa\u4e8e\u5927\u4f6c\u5f00\u53d1\u7684  [[GmeekVercount](https://blog.meekdai.com/Gmeek/plugins/GmeekVercount.js)](https://blog.meekdai.com/Gmeek/plugins/GmeekVercount.js)  \u8fdb\u884c\u4e8c\u6b21\u5f00\u53d1\n\u4e2a\u4eba\u53ea\u8fdb\u884c\u4e86\u4e00\u4e9b\u7b80\u5355\u4fee\u6539\n1. \u6dfb\u52a0\u5e42\u7b49\u6027\n2. \u7a7a\u503c\u4fdd\u62a4\n3. `IIFE` \u5c01\u88c5\n\n\u94fe\u63a5\u5982\u4e0b [[GmeekPageView](https://blog.caicai.asia/GmeekUtils/GmeekPageView-20261107.js)](https://blog.caicai.asia/GmeekUtils/GmeekPageView-20261107.js)\n\n## [GmeekTOC](https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js)\n\n\u6587\u7ae0\u76ee\u5f55\u63d2\u4ef6\uff0c\u7531\u4e8e\u5b98\u65b9\u63a8\u8350\u63d2\u4ef6 [GmeekTOC](https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js) \u4e0e [[articletoc](https://blog.meekdai.com/Gmeek/plugins/articletoc.js)](https://blog.meekdai.com/Gmeek/plugins/articletoc.js) \u4e0d\u592a\u597d\u7528\uff0c\u4e2a\u4eba\u57fa\u4e8e`[GmeekTOC](https://blog.caicai.asia/GmeekUtils/GmeekTOC-20261107.js)` \u63d2\u4ef6\u91cd\u65b0\u4e8c\u5f00\u4e86\u53e6\u5916\u4e00\u4e2a `GmeekTOC` \u63d2\u4ef6\n\n\u94fe\u63a5\u5982\u4e0b [GmeekTOC](https://blog.caicai.asia/GmeekUtils/GmeekTOC-20261107.js)\n\n\n# \u63d2\u4ef6\u6574\u5408\n\n\u7531\u4e8e\u914d\u7f6e\u6587\u4ef6 `config.json` \u5173\u4e8e `script` \u952e\u591a\u63d2\u4ef6\u5f15\u7528\u7684\u95ee\u9898\u8fc7\u4e8e\u81c3\u80bf\uff0c\u672c\u4eba\u53c8\u53e6\u5916\u5199\u4e86\u4e00\u4e2a `\u63d2\u4ef6\u52a0\u8f7d\u63d2\u4ef6` `Gmeek-load-plugins` \u53ea\u9700\u8981\u52a0\u8f7d  `Gmeek-load-plugins`  \u63d2\u4ef6\u5c31\u53ef\u4ee5\u907f\u514d\u8be5\u60c5\u51b5\n\n\u591a\u63d2\u4ef6\u52a0\u8f7d\u5b98\u65b9\u5199\u6cd5  \n\n\u4ee5\u4e0b\u4e3a3\u4e2a\u7b80\u5355\u63d2\u4ef6\u52a0\u8f7d\u65b9\u5f0f\n```json\n'script':'<script src='https://blog.caicai.asia/GmeekUtils/GmeekTOC-20261106.js'></script><script src='https://blog.caicai.asia/GmeekUtils/GmeekButton-Top-Foot.20261107-row.js'></script><script src='https://blog.caicai.asia/GmeekUtils/Gmeek-Article-RSS-TOC-20261107.js'></script>'\n```\n\n\n\u6574\u5408\u5199\u6cd5\n```json\n'script':'<script src='https://blog.caicai.asia/plugins/Gmeek-load-plugins-20261107.js'></script>'\n```\n\n\u53ea\u9700\u8981\u7b80\u5355\u7ef4\u62a4\u4e00\u4e2a `PLUGIN_URLS` \u63d2\u4ef6\u5217\u8868\u5c31\u53ef\u4ee5\u5b9e\u73b0\u591a\u63d2\u4ef6\u52a8\u6001\u52a0\u8f7d\n\n```js\nvar PLUGIN_URLS = [\n\n        // 1. \u5de6\u4fa7\uff1a\u57fa\u4e8e RSS \u7684\u6587\u7ae0\u5bfc\u822a\n        LOAD_BASE_URL + 'Gmeek-Article-RSS-TOC-20261107.js',\n\n        // 2. \u53f3\u4fa7\uff1a\u6587\u7ae0\u76ee\u5f55 TOC\n        LOAD_BASE_URL + 'GmeekTOC-20261107.js',\n\n        // 3. \u53f3\u4e0b\u89d2\uff1a\u56de\u5230\u9876\u90e8/\u5e95\u90e8\u6309\u94ae \n        // GmeekButton-Top-Foot-row-20261107.js/GmeekButton-Top-Foot-column-20261107.js \u53ea\u80fd\u9009\u62e9\u52a0\u8f7d\u5176\u4e2d\u4e00\u4e2a\n        LOAD_BASE_URL + 'GmeekButton-Top-Foot-row-20261107.js'\n\n    ];\n```\n\n\n\u94fe\u63a5\u5982\u4e0b  [[Gmeek-load-plugins](https://github.com/paoludecaic/paoludecaic.github.io/blob/main/static/plugins/Gmeek-load-plugins-20261107.js)](https://github.com/paoludecaic/paoludecaic.github.io/blob/main/static/plugins/Gmeek-load-plugins-20261107.js)\u3002", "top": 0, "createdAt": 1794058496, "style": "<style>.markdown-alert{padding:0.5rem 1rem;margin-bottom:1rem;border-left:.25em solid var(--borderColor-default,var(--color-border-default));}.markdown-alert .markdown-alert-title {display:flex;font-weight:var(--base-text-weight-medium,500);align-items:center;line-height:1;}.markdown-alert>:first-child {margin-top:0;}.markdown-alert>:last-child {margin-bottom:0;}</style><style>.markdown-alert.markdown-alert-tip {border-left-color:var(--borderColor-success-emphasis, var(--color-success-emphasis));background-color:var(--color-success-subtle);}.markdown-alert.markdown-alert-tip .markdown-alert-title {color: var(--fgC